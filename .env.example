# GEMINI_API_KEY / AI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
# You can also configure AI_API_KEY for external/custom environments.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_GEMINI_API_KEY"

# AI_MODEL: Model to use for cryptocurrency analysis.
# Supported options: 'gemini-flash-latest' (recommended default), 'gemini-3.8-flash', 'gemini-3.1-flash-lite'
AI_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# KryptoPulse Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production deployment on Vercel:
#   Go to Vercel Dashboard > Project > Settings > Environment Variables
#   Add the keys below (do NOT check any secrets into Git).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI API Configuration (Server-Side Only - Never exposed to frontend)
# ------------------------------------------------------------------------------
# AI_API_KEY / GEMINI_API_KEY:
# Your Google Gemini or OpenAI API key. Both variable names are supported.
# In Google AI Studio, this is automatically injected as GEMINI_API_KEY.
# On Vercel / Render / Railway, set AI_API_KEY or GEMINI_API_KEY in the dashboard.
AI_API_KEY="your_gemini_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# AI_MODEL:
# Supported Gemini models:
#   - gemini-3.8-flash (recommended default, fast and comprehensive)
AI_MODEL="gemini-3.8-flash"

# AI_PROVIDER:
#   - 'gemini' (default, Google GenAI SDK)
#   - 'openai' or 'openai-compatible' (for custom inference endpoints)
AI_PROVIDER="gemini"

# (Optional) For OpenAI-compatible providers:
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# ------------------------------------------------------------------------------
# 2. Cryptocurrency Market Data API Configuration (Optional)
# ------------------------------------------------------------------------------
# CRYPTO_API_KEY / COINGECKO_API_KEY:
# Optional CoinGecko Demo or Pro API key.
# If omitted, KryptoPulse automatically uses its tiered multi-provider
# aggregation engine (CoinGecko public feed, Binance 24hr tickers, and dynamic
# exchange rate conversions) to provide 100% real live data without rate limits.
CRYPTO_API_KEY=""
COINGECKO_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"

# APP_URL:
# Base URL where the app is hosted (injected automatically on Cloud Run / Vercel)
APP_URL="https://your-app.vercel.app"
